#!/bin/sh
set -eu

remote_name="${1:-origin}"
remote_url="${2:-}"
repo_root="$(git rev-parse --show-toplevel)"
firmware_version_file="Firmware/GPAD_API/FIRMWARE_VERSION"
littlefs_version_file="Firmware/GPAD_API/LITTLEFS_VERSION"
littlefs_data_path="Firmware/GPAD_API/data"

has_branch_push=0
firmware_changed=0
littlefs_changed=0
firmware_version_already_in_push=0
littlefs_version_already_in_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  case "$local_ref" in
    refs/heads/*|HEAD)
      has_branch_push=1
      firmware_changed=1
      ;;
  esac

  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] &&
    ! git diff --quiet "$remote_sha..$local_sha" -- "$firmware_version_file"; then
    firmware_version_already_in_push=1
  fi
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git diff --quiet "$remote_sha..$local_sha" -- "$firmware_version_file"; then
      firmware_changed=1
    fi
    if ! git diff --quiet "$remote_sha..$local_sha" -- "$littlefs_version_file"; then
      littlefs_version_already_in_push=1
    fi
    if ! git diff --quiet "$remote_sha..$local_sha" -- "$littlefs_data_path"; then
      littlefs_changed=1
    fi
  fi
done

if [ "$has_branch_push" -eq 0 ]; then
  exit 0
fi

cd "$repo_root"

if [ "$littlefs_changed" -eq 0 ] && [ "$firmware_changed" -eq 0 ]; then
  exit 0
fi

if ! git diff --cached --quiet; then
  echo "There are staged changes. Commit or unstage them before the GPAD version hook runs." >&2
  exit 1
fi

if [ "$firmware_changed" -eq 1 ] && [ "$firmware_version_already_in_push" -eq 0 ]; then
  if ! git diff --quiet -- "$firmware_version_file"; then
    echo "GPAD firmware version is already modified. Commit it before pushing." >&2
    exit 1
  fi
  python3 scripts/bump_gpad_firmware_version.py
  git add "$firmware_version_file"
fi

if [ "$littlefs_changed" -eq 1 ] && [ "$littlefs_version_already_in_push" -eq 0 ]; then
  if ! git diff --quiet -- "$littlefs_version_file"; then
    echo "LittleFS web-page version is already modified. Commit it before pushing." >&2
    exit 1
  fi
  python3 scripts/bump_gpad_firmware_version.py \
    --version-file "$littlefs_version_file" \
    --label "LittleFS web-page"
  git add "$littlefs_version_file"
fi

if git diff --cached --quiet; then
  exit 0
fi

git commit -m "Bump GPAD firmware and web-page versions"

echo "Created a GPAD firmware version commit for ${remote_name} ${remote_url}." >&2
echo "Re-run git push to send your code with the new firmware version." >&2
exit 1
